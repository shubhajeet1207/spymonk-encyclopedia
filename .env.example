# Copy this file to `.env` and fill in values. Never commit `.env`.

# NVIDIA NIM API key from https://build.nvidia.com/settings
LLM_API_KEY=nvapi-your-key-here
# NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA Open Models (DeepSeek) — OpenAI-compatible
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_MAX_TOKENS=2048
# Only enable this vendor-specific option for providers that support chat_template_kwargs.
LLM_DISABLE_THINKING=true
# Per-call provider timeout and retry bound; research has a separate run deadline.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Parallel model calls within one research run.
# LLM_CONCURRENCY=3
# Ceiling on chat-model calls per UTC day across the whole API (0 disables it).
# LLM_DAILY_CALL_LIMIT=2000

# Research jobs: wall-clock limit per run, parallel runs, and how many may wait.
# RESEARCH_MAX_SECONDS=900
# RESEARCH_MAX_CONCURRENT_JOBS=1
# RESEARCH_MAX_QUEUED_JOBS=4
# Total bytes one research run may download, and parallel page fetches.
# RESEARCH_MAX_FETCH_BYTES=83886080
# FETCH_CONCURRENCY=4

# Requests per minute per client for the expensive endpoints.
# RATE_LIMIT_RESEARCH_PER_MINUTE=6
# RATE_LIMIT_ASK_PER_MINUTE=30
# RATE_LIMIT_UPLOAD_PER_MINUTE=10
# RATE_LIMIT_MAINTENANCE_PER_MINUTE=3

# Embeddings: `huggingface` (local) or `openai` (recommended for hosted backends).
# Changing the provider or model requires rebuilding the index:
#   python -m backend.core.reindex --apply
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Longest input the local model reads (all-MiniLM-L6-v2: 256); chunks are sized below it.
# EMBEDDING_MAX_TOKENS=256
# Load the local model at startup instead of on the first search.
# EMBEDDINGS_WARMUP=false
# Cosine similarity below which a search result is treated as unrelated.
# RETRIEVE_MIN_SIMILARITY=0.25

# PDF reports for unanswered questions use system fonts (Segoe UI, Noto Sans,
# DejaVu Sans). Point this at a directory with NotoSans-Regular.ttf,
# NotoSans-Bold.ttf and NotoSansDevanagari-Regular.ttf for consistent output.
# REPORT_FONT_DIR=

# Logs are written under SPYMONK_DATA_DIR/logs: spymonk-api.log (rotated) and
# research/ with one developer log per research run (newest 500 kept).
# LOG_TO_FILE=true
# SPYMONK_LOG_DIR=
# LOG_FILE_MAX_BYTES=5242880
# LOG_FILE_BACKUPS=5
# RESEARCH_LOG_KEEP=500

# Used only when EMBEDDING_PROVIDER=openai.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your-embedding-provider-key
# EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1

# Chroma: `chroma-local` for local development; `chroma-cloud` for hosted vectors.
VECTOR_STORE_PROVIDER=chroma-local
# Required when VECTOR_STORE_PROVIDER=chroma-cloud. Create credentials in Chroma Cloud.
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# Optional mounted/persistent data directory for the FastAPI host.
# When unset, the project root is used (local development only).
# SPYMONK_DATA_DIR=/var/data/spymonk
# Exactly one API process may use a data directory; a second one refuses to start.
# Disable only if the file-backed stores have been replaced by shared services.
# SPYMONK_INSTANCE_LOCK=true

# Exact comma-separated browser origins allowed to write to the API.
# Add the production and preview Vercel origins that should access this backend.
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Exact API Host header values permitted by the backend (include the deployed API hostname).
APP_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional single-user API token. If unset, only loopback clients can use /api/* (except /api/health).
# Use a long random value. Enter it in the frontend when prompted; never put it in VITE_* variables.
# APP_API_TOKEN=

# --- Hosting (see docs/DEPLOY_HF_SPACES.md) ---
# Marks a hosted deployment: requires APP_API_TOKEN, hides /docs, rebuilds a missing index at startup.
# Set automatically on Hugging Face Spaces, which also supplies the allowed host and origin.
# SPYMONK_HOSTED=false
# Back up the archive for hosts whose disk is wiped on restart: hf-dataset or directory.
# BACKUP_TARGET=
# BACKUP_HF_REPO=your-name/spymonk-data
# Fine-grained token with write access to that dataset only (not your personal HF_TOKEN).
# BACKUP_HF_TOKEN=
# BACKUP_DIRECTORY=
# BACKUP_INTERVAL_SECONDS=15
# REBUILD_INDEX_ON_START=false
# APP_API_DOCS=true
# APP_FRAME_ANCESTORS='none'

# Backend console logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
# Optional HTTP client request logging: WARNING by default; use INFO for each request.
# HTTPX_LOG_LEVEL=INFO
